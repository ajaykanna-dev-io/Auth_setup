
export enum Role {
  USER = 'USER',
  ADMIN = 'ADMIN',
  MANAGER = 'MANAGER',
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?  @unique
  name         String?
  passwordHash String

  role         Role     @default(USER)

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}